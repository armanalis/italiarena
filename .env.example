# Public Supabase keys (safe for the browser). Get these from your Supabase project
# or ask a maintainer which values to use for contribution work.
# After a vanity subdomain or custom domain is live, use that host here
# (https://italiarena.supabase.co or https://auth.italiarena.com) instead of the
# random *.supabase.co project URL. Same anon key either way.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web client ID from Google Cloud Console (APIs & Services → Credentials),
# the same value already in Supabase → Authentication → Providers → Google.
# With this set, "Continue with Google" stays on italiarena.com via Google
# Identity Services instead of bouncing through *.supabase.co.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Fallback site URL for local dev and server-side email links. Use http://localhost:3000
# while developing locally; use https://italiarena.com in production (not the old
# language-quiz-one.vercel.app URL). OAuth always uses https://italiarena.com/auth/callback
# outside localhost. Also set Supabase → Authentication → URL configuration → Site URL
# to https://italiarena.com, add production and http://localhost:3000/** redirect URLs,
# and configure SMTP + email templates (see README).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Groq: Ask AI in matches + AI pre-check on community submissions + bulk question audit
GROQ_API_KEY=

# Service role: required for password-reset email checks; recommended for AI pre-check and admin lookups
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (daily reminders + future chat alerts). Generate with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@italiarena.com

# Protects /api/cron/daily-reminder (Vercel Cron sends Authorization: Bearer <CRON_SECRET>).
# Hobby plan: cron may run only once per day — see vercel.json schedule.
CRON_SECRET=
