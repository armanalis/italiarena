# Public Supabase keys (safe for the browser). Get these from your Supabase project
# or ask a maintainer which values to use for contribution work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fallback site URL for local dev and server-side email links. Use http://localhost:3000
# while developing locally; use https://italiarena.com in production (not the old
# language-quiz-one.vercel.app URL). OAuth always uses https://italiarena.com/auth/callback
# outside localhost. Also set Supabase → Authentication → URL configuration → Site URL
# to https://italiarena.com, add production and http://localhost:3000/** redirect URLs,
# and configure SMTP + email templates (see README).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Groq: Ask AI in matches + AI pre-check on community submissions (advisory only)
GROQ_API_KEY=

# Service role: required for password-reset email checks; recommended for AI pre-check and admin lookups
SUPABASE_SERVICE_ROLE_KEY=
